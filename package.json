{
  "name": "libras-translator",
  "version": "0.1.0",
  "description": "Plugin React de tradução simultânea Português → Libras com o avatar do VLibras. Embute em apps de chamada de vídeo.",
  "type": "module",
  "main": "./dist/libras-translator.js",
  "module": "./dist/libras-translator.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/libras-translator.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "demo": "yarn --cwd examples/demo dev",
    "vc:server": "yarn --cwd examples/video-call/server dev",
    "vc:client": "yarn --cwd examples/video-call/client dev",
    "vc": "concurrently \"yarn vc:server\" \"yarn vc:client\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint src",
    "lint:fix": "biome lint --write src",
    "format": "biome format --write src",
    "check": "biome check src",
    "check:fix": "biome check --write src"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "@vitest/coverage-v8": "^2.1.0",
    "concurrently": "^10.0.4",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^2.1.0"
  }
}
