# === Lib: ASR de nuvem ===
# Necessário apenas para audio: { kind: 'stream' } com Deepgram.
# Microfone (Web Speech) e texto não precisam de key.
# Crie uma key gratuita em https://deepgram.com
VITE_DEEPGRAM_KEY=

# === Lib: VLibras (opcionais — defaults públicos usados se ausentes) ===
# Endpoint PT→glosa. Default: https://traducao2.vlibras.gov.br/translate
VITE_VLIBRAS_TRANSLATOR_URL=
# Bundle do player Unity. Default: /vlibras/vlibras.js (public/ local)
# ⚠️ Ponto de atenção: bundle não é npm, sem versionamento automático
VITE_VLIBRAS_BUNDLE_URL=
